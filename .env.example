# ====== SERVER SOZLAMALARI ======
PORT=5000
# MongoDB manzili. Bo'sh qoldirsangiz yoki Mongo topilmasa, lokal zaxira baza (server/data) ishlaydi (faqat development)
MONGO_URI=mongodb://127.0.0.1:27017/demomaker
# Productionda NODE_ENV=production qo'ying: zaif sozlamalar bilan server ishga tushmaydi
# NODE_ENV=production
# JWT uchun maxfiy kalit (kamida 32 belgi). Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-before-deploy
JWT_EXPIRES=7d
# Telegram tokenini shifrlash kaliti (bo'lmasa JWT_SECRET ishlatiladi)
ENCRYPTION_KEY=
# Birinchi admin (faqat birinchi ishga tushishda yaratiladi). Kamida 10 belgi!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123
# Frontend manzili (CORS uchun)
CLIENT_URL=http://localhost:5173
# Nginx ortida ishlaganda 1
# TRUST_PROXY=1
# Sayt domeni (sitemap.xml uchun)
# SITE_URL=https://example.uz
